(text "FOUR PASSIVE DIFFERENTIAL LANES" (at 25.4 25.4 0) (effects (font (size 2 2)) (justify left)) (uuid "d008a3a4-409c-45b3-be52-674a736dcf09"))
(text "J1 -> J2 / 100 ohm differential target / LANE2 changes to B.Cu" (at 25.4 30.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e6958b9f-dbb9-4ecd-a770-941a1b2b2e73"))
(text "Signal connector pins carry four differential lanes and ground." (at 25.4 85.09 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "2ecd0a19-1fc4-4ef1-b399-df04d80af08c"))
(text "5 V INPUT AND RESISTIVE LOAD" (at 25.4 96.52 0) (effects (font (size 2 2)) (justify left)) (uuid "073f6584-57c9-4e01-8f74-b6fec03c9988"))
(text "4 x 68 ohm, >=1 W each. At 5 V: 73.53 mA and 0.368 W per branch." (at 25.4 101.6 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "8f130814-566b-42ec-8d51-2e05f40e331d"))
(text "No receiver, transmitter, termination or protocol controller is fitted." (at 111.76 134.62 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d5ca2fa0-c8b3-4eed-853a-5e6157cff68c"))
(text "Connector bandwidth and manufacturing tolerances require separate validation." (at 111.76 139.7 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b96733b5-ce3b-452e-97e9-db113363a377"))
(text "MECHANICAL / M2 CLEARANCE HOLES" (at 25.4 149.86 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "a7135e54-8341-4ab9-9b1d-0fa51e191ce7"))
(text "Demonstration design; calculations are not physical measurements." (at 25.4 177.8 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "4deb14c3-4c64-446f-8420-cb2ba44358d3"))
